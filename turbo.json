{
  "$schema": "https://turborepo.dev/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": [".svelte-kit/**", "build/**"]
    },
    "check-types": {
      "dependsOn": ["^check-types"]
    },
    "test": {
      "outputs": []
    },
    "test:integration": {
      "cache": false,
      "env": [
        "POSTGRES_TEST_ADMIN_CONNECTION_STRING",
        "REDIS_PACKAGE_TEST_URL",
        "REDIS_TEST_URL",
        "S3_TEST_ACCESS_KEY_ID",
        "S3_TEST_BUCKET",
        "S3_TEST_ENDPOINT",
        "S3_TEST_REGION",
        "S3_TEST_SECRET_ACCESS_KEY"
      ]
    },
    "dev": {
      "persistent": true,
      "cache": false
    },
    "db:generate": {
      "cache": false
    },
    "db:migrate": {
      "dependsOn": ["db:generate"],
      "cache": false
    },
    "db:push": {
      "cache": false
    },
    "synth": {
      "inputs": ["src/**/*.ts", "cdk8s.yaml"],
      "outputs": ["manifests/**"]
    },
    "//#lint": {
      "inputs": ["apps/**/*.ts", "apps/**/*.svelte", "packages/**/*.ts", "biome.json"],
      "outputs": []
    }
  }
}
