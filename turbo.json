{
  "$schema": "https://turborepo.dev/schema.json",
  "tasks": {
    "build": {
      "outputs": ["dist/**"]
    },
    "check-types": {
      "dependsOn": ["^check-types"]
    },
    "dev": {
      "persistent": true,
      "cache": false
    },
    "db:generate": {
      "cache": false
    },
    "db:migrate": {
      "dependsOn": ["db:generate"],
      "cache": false
    },
    "db:push": {
      "cache": false
    },
    "//#lint": {
      "inputs": [
        "apps/**/*.ts",
        "apps/**/*.tsx",
        "packages/**/*.ts",
        "eslint.config.ts"
      ],
      "outputs": []
    }
  }
}
