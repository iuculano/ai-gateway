{
  "name": "worker-model-catalog",
  "type": "module",
  "scripts": {
    "dev": "bun run --hot src/index.ts",
    "build": "bun build src/index.ts --compile --minify-whitespace --minify-syntax --outfile dist/worker-model-catalog",
    "start": "bun run src/index.ts",
    "check-types": "bunx tsc --noEmit",
    "test:unit": "bun test --isolate tests/unit",
    "test:unit:coverage": "bun test --coverage --isolate tests/unit",
    "test:integration": "bun test --preload ./tests/integration/setup.ts tests/integration"
  },
  "dependencies": {
    "@hono/swagger-ui": "^0.5.3",
    "@hono/zod-openapi": "^1.6.1",
    "@repo/core": "workspace:*",
    "@repo/drizzle": "workspace:*",
    "@repo/hono": "workspace:*",
    "hono": "^4.13.5"
  },
  "devDependencies": {
    "@repo/test-helpers": "workspace:*",
    "@types/bun": "^1.4.0",
    "typescript": "^7.0.2"
  }
}
