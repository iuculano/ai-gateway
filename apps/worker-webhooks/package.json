{
  "name": "worker-webhooks",
  "type": "module",
  "scripts": {
    "dev": "bun run --hot src/index.ts",
    "build": "bun build src/index.ts --compile --minify-whitespace --minify-syntax --outfile dist/worker-webhooks",
    "start": "bun run src/index.ts",
    "check-types": "bunx tsc --noEmit",
    "test:unit": "bun test --isolate tests/unit",
    "test:unit:coverage": "bun test --coverage --isolate tests/unit",
    "test:integration": "bun test --preload ./tests/integration/setup.ts tests/integration"
  },
  "dependencies": {
    "@hono/zod-openapi": "^1.6.3",
    "@repo/core": "workspace:*",
    "@repo/drizzle": "workspace:*",
    "@repo/hono": "workspace:*",
    "hono": "^4.13.14"
  },
  "devDependencies": {
    "@repo/test-helpers": "workspace:*",
    "@types/bun": "^1.4.4",
    "typescript": "^6.0.3"
  }
}
