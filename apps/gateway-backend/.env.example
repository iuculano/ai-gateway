# Copy to .env and fill in. Values here are the local/devcontainer defaults.

PORT=3000
# development | production | test
NODE_ENV=development
# trace | debug | info | warn | error
LOG_LEVEL=info

# Read by @repo/drizzle at runtime. Connect as the DML-only app_user rather than
# giving the application schema-owner privileges. Create the role with
# packages/drizzle/sql/002-application-role.sql.
# From the devcontainer use host.docker.internal instead of localhost.
POSTGRES_CONNECTION_STRING=postgresql://app_user:app_user@localhost:5432/ai_gateway

# Read by drizzle-kit for db:generate/push and by role setup, which need DDL and
# role management that app_user deliberately lacks. Must point at the
# same database as above - the name must match POSTGRES_DB in docker-compose.yml.
POSTGRES_ADMIN_CONNECTION_STRING=postgresql://postgres:postgres@localhost:5432/ai_gateway

# The integration test tier (apps/backend/tests/integration). A SEPARATE
# database, because the suite truncates every table between tests - the harness
# refuses to run against a name that does not end in _test. Create it once with
# `bun run test:db:setup`, and again after any schema change.
# From the devcontainer use host.docker.internal instead of localhost.
POSTGRES_TEST_CONNECTION_STRING=postgresql://app_user:app_user@localhost:5432/ai_gateway_test
POSTGRES_TEST_ADMIN_CONNECTION_STRING=postgresql://postgres:postgres@localhost:5432/ai_gateway_test

# Object storage for log request/response payloads, written zstd compressed as
# two objects per log. Any S3-compatible store works; docker-compose.yml runs
# MinIO for local development.
# From the devcontainer use host.docker.internal instead of localhost.
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
S3_BUCKET=ai-gateway-logs
# MinIO ignores this, but the S3 client requires a value.
S3_REGION=us-east-1

# From the devcontainer use host.docker.internal instead of localhost.
REDIS_URL=redis://localhost:6379
# Optional - omit unless the instance is password-protected.
#REDIS_USERNAME=
#REDIS_PASSWORD=

# The identity provider issuing access tokens.
IDENTITY_PROVIDER_TYPE=zitadel
IDENTITY_PROVIDER_TOKEN_ISSUER=https://your-instance.zitadel.cloud
# The Zitadel PROJECT id - present in every project token's aud, unlike the
# per-app client ids. No default: a made-up audience can never match a real
# token, so a missing value should fail the boot, not every request.
IDENTITY_PROVIDER_TOKEN_AUDIENCE=
