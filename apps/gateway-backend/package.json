{
  "name": "gateway-backend",
  "type": "module",
  "module": "src/index.ts",
  "types": "src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./routes": "./src/routes.ts"
  },
  "scripts": {
    "dev": "bun run --inspect --hot src/index.ts",
    "start": "bun run src/index.ts",
    "check-types": "bunx tsc --noEmit",
    "test": "bun test --parallel tests/unit",
    "test:coverage": "bun test --coverage --parallel tests/unit",
    "test:integration": "bun test --preload ./tests/integration/setup.ts tests/integration",
    "test:db:setup": "bun run tests/integration/prepare-database.ts",
    "stress:logs": "bun run tests/stress/logs.stress.ts",
    "stress:gateway": "bun run tests/stress/gateway.stress.ts"
  },
  "dependencies": {
    "@ai-sdk/azure": "^4.0.37",
    "@ai-sdk/openai": "^4.0.36",
    "@hono/swagger-ui": "^0.6.1",
    "@hono/zod-openapi": "^1.4.0",
    "@repo/auth": "workspace:*",
    "@repo/core": "workspace:*",
    "@repo/drizzle": "workspace:*",
    "@repo/hono": "workspace:*",
    "@repo/object-storage": "workspace:*",
    "@repo/redis": "workspace:*",
    "ai": "^7.0.58",
    "drizzle-orm": "^1.0.0-rc.4",
    "hono": "^4.12.26",
    "lru-cache": "^11.5.2",
    "neverthrow": "^8.2.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/bun": "^1.3.9",
    "typescript": "^6.0.3"
  }
}
