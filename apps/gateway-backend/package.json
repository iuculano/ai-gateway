{
  "name": "gateway-backend",
  "type": "module",
  "module": "src/index.ts",
  "types": "src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./routes": "./src/routes.ts",
    "./schemas/chat-completions": "./src/api/chat-completions/chat-completions.schemas.ts",
    "./prompts/builtins": "./src/api/prompts/prompts.builtins.ts"
  },
  "scripts": {
    "dev": "bun run --inspect --hot src/index.ts",
    "build": "bun build src/index.ts --compile --minify-whitespace --minify-syntax --outfile dist/gateway-backend",
    "start": "bun run src/index.ts",
    "check-types": "bunx tsc --noEmit",
    "test:unit": "bun test --isolate tests/unit",
    "test:unit:coverage": "bun test --coverage tests/unit",
    "test:integration": "bun test --preload ./tests/integration/setup.ts tests/integration",
    "test:db:setup": "bun run tests/integration/prepare-database.ts",
    "stress:logs": "bun run tests/stress/logs.stress.ts",
    "stress:gateway": "bun run tests/stress/gateway.stress.ts"
  },
  "dependencies": {
    "@ai-sdk/azure": "^4.0.46",
    "@ai-sdk/openai": "^4.0.45",
    "@hono/swagger-ui": "^0.6.1",
    "@hono/zod-openapi": "^1.6.1",
    "@repo/auth": "workspace:*",
    "@repo/core": "workspace:*",
    "@repo/drizzle": "workspace:*",
    "@repo/hono": "workspace:*",
    "@repo/object-storage": "workspace:*",
    "@repo/redis": "workspace:*",
    "ai": "^7.0.71",
    "drizzle-orm": "^1.0.0-rc.5-ab785fc",
    "hono": "^4.13.3",
    "lru-cache": "^11.5.2",
    "neverthrow": "^8.2.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@repo/test-helpers": "workspace:*",
    "@types/bun": "^1.4.0",
    "typescript": "^6.0.3"
  }
}
