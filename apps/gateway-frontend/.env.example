# OIDC (BFF auth). Register a Web application in your Zitadel project with:
#   - Authentication method: PKCE (no client secret)
#   - Redirect URI:          http://localhost:5173/auth/callback
#   - Auth Token Type:       JWT (the backend verifies the access token as a JWT)
ZITADEL_ISSUER=https://your-instance.zitadel.cloud
ZITADEL_CLIENT_ID=

# Refresh tokens. Off by default because `offline_access` is only honoured once
# the refresh_token grant is enabled on the IDP application, and an IDP that has
# not been configured for it may reject the authorization request outright
# rather than quietly omitting the token - which would break login entirely.
#
# Enable in two steps, in this order:
#   1. Zitadel console: tick the Refresh Token grant on the application, and
#      set the refresh token idle / expiry lifetimes.
#   2. Set this to true.
#
# Left false, sessions end with their access token, exactly as before.
OIDC_REFRESH_ENABLED=false

# Where the IDP returns the browser after RP-initiated logout. Sent only when
# set, because an unregistered value is rejected and strands the user on an IDP
# error page. Must be registered as a Post Logout URI on the application.
# POST_LOGOUT_REDIRECT_URI=http://localhost:5173/auth/login

# Session lifetimes, in seconds. The idle window slides on every refresh; the
# absolute cap does not move and is what bounds a stolen session id.
# Only meaningful when OIDC_REFRESH_ENABLED is true - without a refresh token a
# session cannot outlive its access token whatever these say.
SESSION_IDLE_SECONDS=28800
SESSION_ABSOLUTE_SECONDS=604800

# Where the BFF proxy forwards /api/* requests.
BACKEND_URL=http://localhost:3000

# Session store (sessions are server-side; the cookie only holds an id).
# From the devcontainer use host.docker.internal instead of localhost.
REDIS_URL=redis://localhost:6379
