{
  "name": "@repo/drizzle",
  "type": "module",
  "module": "index.ts",
  "exports": {
    ".": "./index.ts",
    "./schemas": "./schemas.ts",
    "./client": "./client.ts"
  },
  "types": "./index.ts",
  "scripts": {
    "build": "bunx tsc --noEmit",
    "check-types": "bunx tsc --noEmit",
    "db:generate": "bunx --bun drizzle-kit generate --config=drizzle.config.ts",
    "db:migrate": "bunx --bun drizzle-kit migrate --config=drizzle.config.ts",
    "db:push": "bunx --bun drizzle-kit push --config=drizzle.config.ts"
  },
  "dependencies": {
    "drizzle-orm": "beta"
  },
  "devDependencies": {
    "@types/bun": "^1.3.9",
    "drizzle-kit": "beta"
  },
  "peerDependencies": {
    "typescript": "^5"
  }
}
