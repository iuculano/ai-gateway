{
  "name": "@repo/drizzle",
  "type": "module",
  "module": "index.ts",
  "exports": {
    ".": "./index.ts",
    "./schemas": "./schemas.ts",
    "./client": "./client.ts"
  },
  "types": "./index.ts",
  "scripts": {
    "check-types": "bunx tsc --noEmit",
    "db:generate": "bunx --bun drizzle-kit generate --config=drizzle.config.ts",
    "db:migrate": "bunx --bun drizzle-kit migrate --config=drizzle.config.ts",
    "db:push": "bunx --bun drizzle-kit push --config=drizzle.config.ts"
  },
  "dependencies": {
    "drizzle-orm": "^1.0.0-rc.5-ab785fc",
    "zod": "^4.5.2"
  },
  "devDependencies": {
    "@types/bun": "^1.4.0",
    "drizzle-kit": "^1.0.0-rc.5-ab785fc"
  },
  "peerDependencies": {
    "typescript": "^6.0.3"
  }
}
