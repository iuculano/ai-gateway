{
  "name": "ai-gateway-workspace",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.4.0",
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "start": "turbo run start",
    "check-types": "turbo run check-types",
    "test": "turbo run test:unit test:integration",
    "test:unit": "turbo run test:unit",
    "test:unit:coverage": "turbo run test:unit:coverage",
    "test:integration": "turbo run test:integration",
    "test:db:setup": "turbo run test:db:setup",
    "db:generate": "turbo run db:generate",
    "db:migrate": "turbo run db:migrate",
    "db:push": "turbo run db:push",
    "check": "bunx biome ci",
    "lint": "bunx biome lint",
    "lint:fix": "bunx biome lint --write",
    "format": "bunx biome format",
    "format:fix": "bunx biome format --write",
    "stress:logs": "bun run --cwd apps/gateway-backend stress:logs",
    "stress:gateway": "bun run --cwd apps/gateway-backend stress:gateway"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "overrides": {
    "cookie": "0.7.2"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.4",
    "turbo": "^2.10.11"
  }
}
