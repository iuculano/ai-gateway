<clickhouse>
  <storage_configuration>
    <disks>
      <object_store>
        <type>s3</type>
        <endpoint from_env="CLICKHOUSE_S3_ENDPOINT"/>
        <access_key_id from_env="CLICKHOUSE_S3_ACCESS_KEY_ID"/>
        <secret_access_key from_env="CLICKHOUSE_S3_SECRET_ACCESS_KEY"/>
        <region from_env="CLICKHOUSE_S3_REGION"/>
        <metadata_path>/var/lib/clickhouse/disks/object_store/</metadata_path>
      </object_store>
      <object_store_cache>
        <type>cache</type>
        <disk>object_store</disk>
        <path>/var/lib/clickhouse/disks/object_store_cache/</path>
        <max_size from_env="CLICKHOUSE_CACHE_SIZE"/>
        <cache_on_write_operations>1</cache_on_write_operations>
      </object_store_cache>
    </disks>
    <policies>
      <object_store>
        <volumes>
          <main>
            <disk>object_store_cache</disk>
          </main>
        </volumes>
      </object_store>
    </policies>
  </storage_configuration>
</clickhouse>
